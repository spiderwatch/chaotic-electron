#userCard(style=`background: url(${user.bannerURL}) no-repeat center center #000000; background-size: cover;`)
    #userCardContent
        span#userImageName
            img#userCardImage(src=user.avatarURL, alt=`${user.name}'s Avatar`)
            span#userIntroName 
                h2
                    span.thin#userIntro Welcome Back, 
                    span= user.name
        ul(style="margin: 0; padding: 0 0.5rem 0.5rem 0.5rem;")
            li
                span.statTitle
                    span Balance:
                span.statValue.balance
                    i.fa-sharp.fa-ellipsis
            li
                span.statTitle 
                    span Net Worth:
                span.statValue.netWorth
                    i.fa-sharp.fa-ellipsis
        ul(style="margin: 0; padding: 0 0.5rem 0.5rem 0.5rem;")
            if (isAdmin)
                li.admin
                    span.statEmblem
                        i.fa-sharp.fa-solid.fa-shield
            if (hasAlphaAccess)
                li.alpha
                    span.statEmblem
                        i.fa-sharp.fa-solid.fa-star